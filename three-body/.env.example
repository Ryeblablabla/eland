# 复制为 .env.local 后填写。模型配置与密钥只在服务端读取，不会进入前端代码。

# 推荐：复制 model-endpoints.example.json 为 model-endpoints.local.json，再启用这一行。
# THREEBODY_MODEL_CONFIG=./model-endpoints.local.json
# MODEL_NARRATIVE_TIMEOUT_MS=30000
# 实时关键决策只在显式配置 decision 路由时启用；超时或非法结果回退本地规则。
# MODEL_DECISION_TIMEOUT_MS=12000
# MODEL_DECISION_MAX_OUTPUT_TOKENS=600
# 玩家主动与人物交谈必须使用 interaction 模型；统一给足输出额度，模型仍按问题需要简洁作答。
# MODEL_INTERACTION_TIMEOUT_MS=90000
# MODEL_INTERACTION_MAX_OUTPUT_TOKENS=8000
# 每次已发生的口头沟通复用 decision 端点生成表层台词；失败时保留沟通 ActionFact，但不显示文字气泡，规则不会补一条可见原话。
# MODEL_SPEECH_TIMEOUT_MS=12000
# MODEL_SPEECH_MAX_OUTPUT_TOKENS=1080
# 一个月内所有 speech-only 批次合计最多等待多久。
# MODEL_SPEECH_TOTAL_TIMEOUT_MS=24000
# 后代出生时由 naming 路由提出 givenName；非法、重名、超时或缺端点时保留本地种子姓名。
# MODEL_NAMING_TIMEOUT_MS=12000
# MODEL_NAMING_MAX_OUTPUT_TOKENS=480
# MODEL_LIVE_NARRATIVE_TIMEOUT_MS=10000

# SQLite 数据库固定为此父目录下的 eland.sqlite3；运行、存档、实时会话和文明编号共用它。
# THREEBODY_DATA_DIR=./data
# 实时文明会话默认在 24 小时内恢复同一份权威状态。
# ELAND_SESSION_RECOVERY_TTL_MS=86400000
# 实时 Worker 在第一次真实请求时才启动；old space 默认 1536 MB、硬上限 2048 MB，
# young space 默认 64 MB、硬上限 128 MB。显式配置不会突破硬上限。
# ELAND_WORKER_OLD_SPACE_MB=1536
# ELAND_WORKER_YOUNG_SPACE_MB=64
# 长程实验默认每 12 个模拟月持久化一次；超长运行可临时调大以减少大状态压缩次数。
# ELAND_LONG_EVOLUTION_CHECKPOINT_MONTHS=12
# Long-run workers are globally serialized per backend process. Old space
# defaults to 2048 MB and is hard-capped at 2048 MB; lower overrides are allowed.
# ELAND_RUN_WORKER_OLD_SPACE_MB=2048

# 输出规则推进、投影、快照与持久化的分段耗时；默认关闭。
# ELAND_PERF_LOG=1

# model-endpoints.local.json 中 apiKeyEnv 引用的密钥按需填写；局域网 Ollama auth=none 时无需密钥。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
KIMI_API_KEY=

# 未配置 THREEBODY_MODEL_CONFIG 时，继续兼容原 Kimi 接入：
# KIMI_API_URL=https://api.kimi.com/coding/v1/chat/completions
# KIMI_MODEL=kimi-for-coding
# MOONSHOT_API_KEY=
