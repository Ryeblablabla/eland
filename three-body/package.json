{
  "name": "eland",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "eland": "node scripts/eland.mjs",
    "test": "npm run test:core",
    "test:core": "node scripts/test-core.mjs",
    "test:cli": "node scripts/test-eland-cli.mjs",
    "test:simulation": "node scripts/test-simulation.mjs",
    "test:architecture": "node scripts/check-eland-boundaries.mjs",
    "test:persistence": "node scripts/test-sqlite-run-store.mjs && node scripts/test-sqlite-eland-store.mjs",
    "test:session": "node scripts/test-session-replay.mjs",
    "test:workers": "node scripts/test-eland-worker-recovery.mjs && node scripts/test-run-evolution-worker-lifecycle.mjs && node scripts/test-long-evolution-failure-atomicity.mjs",
    "test:limited-embodiment": "node scripts/test-player-embodiment.mjs && node scripts/test-limited-embodiment-session.mjs",
    "test:frontend-session": "node scripts/test-frontend-session-reliability.mjs",
    "test:model-authority": "node scripts/test-model-social-authority.mjs",
    "test:civilization-sequence": "node scripts/test-civilization-sequence.mjs",
    "test:capability-milestones": "node scripts/test-capability-milestones.mjs",
    "test:triple-sun-collapse": "node scripts/test-triple-sun-collapse.mjs",
    "test:civilization-requiem": "node scripts/test-civilization-requiem.mjs",
    "build": "tsc -b && vite build",
    "backend": "npm run backend:build && npm run backend:start",
    "backend:build": "tsc -p tsconfig.server.json && node server/build.mjs",
    "backend:start": "node dist-server/main.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
